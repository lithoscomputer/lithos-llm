expression: rendered
---
{
  "method": "POST",
  "path": "/v1/responses",
  "headers": [
    [
      "accept",
      "*/*"
    ],
    [
      "authorization",
      "[redacted]"
    ],
    [
      "content-length",
      "586"
    ],
    [
      "content-type",
      "application/json"
    ],
    [
      "host",
      "[host]"
    ],
    [
      "user-agent",
      "[user-agent]"
    ]
  ],
  "body": {
    "model": "gpt-5.6-luna-2026-04-01",
    "input": [
      {
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "Apply the patch."
          }
        ]
      },
      {
        "type": "custom_tool_call",
        "call_id": "call_patch",
        "name": "apply_patch",
        "input": "*** Begin Patch\n*** End Patch"
      },
      {
        "type": "custom_tool_call_output",
        "call_id": "call_patch",
        "output": "applied"
      }
    ],
    "stream": false,
    "store": false,
    "include": [
      "reasoning.encrypted_content"
    ],
    "max_output_tokens": 128,
    "tools": [
      {
        "type": "custom",
        "name": "apply_patch",
        "description": "Applies a unified patch to the working tree",
        "format": {
          "type": "grammar",
          "syntax": "lark",
          "definition": "start: TEXT"
        }
      }
    ]
  }
}
