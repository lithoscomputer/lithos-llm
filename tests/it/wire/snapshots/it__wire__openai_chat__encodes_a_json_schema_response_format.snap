        "name": "city_report",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string"
            },
            "population": {
              "type": "integer"
            }
          },
          "required": [
            "city",
            "population"
          ]
        },
        "strict": true
      }
    }
  }
}
