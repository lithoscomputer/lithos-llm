{
  "method": "POST",
  "path": "/v1/chat/completions",
  "headers": [
    [
      "accept",
      "*/*"
    ],
    [
      "authorization",
      "[redacted]"
    ],
    [
      "content-length",
      "783"
    ],
    [
      "content-type",
      "application/json"
    ],
    [
      "host",
      "[host]"
    ],
    [
      "user-agent",
      "[user-agent]"
    ]
  ],
  "body": {
    "max_tokens": 128,
    "messages": [
      {
        "content": "What is the weather in Paris and Madrid?",
        "role": "user"
      },
      {
        "content": "Looking both up.",
        "role": "assistant",
        "tool_calls": [
          {
            "function": {
              "arguments": "{\"city\":\"Paris\"}",
              "name": "get_weather"
            },
            "id": "call_paris",
            "type": "function"
          },
          {
            "function": {
              "arguments": "{\"city\":\"Madrid\"}",
              "name": "get_weather"
            },
            "id": "call_madrid",
            "type": "function"
          }
        ]
      },
      {
        "content": "18C and clear",
        "role": "tool",
        "tool_call_id": "call_paris"
      },
      {
        "content": "the city is unknown",
        "role": "tool",
        "tool_call_id": "call_madrid"
      }
    ],
    "model": "vendor/compat-chat-v2",
    "stream": false,
    "tools": [
      {
        "function": {
          "description": "Reads the current weather for a city",
          "name": "get_weather",
          "parameters": {
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ],
            "type": "object"
          }
        },
        "type": "function"
      }
    ]
  }
