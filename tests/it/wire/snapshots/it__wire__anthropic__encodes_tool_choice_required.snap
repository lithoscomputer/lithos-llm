{
  "method": "POST",
  "path": "/v1/messages",
  "headers": [
    [
      "accept",
      "*/*"
    ],
    [
      "anthropic-version",
      "2023-06-01"
    ],
    [
      "content-length",
      "672"
    ],
    [
      "content-type",
      "application/json"
    ],
    [
      "host",
      "[host]"
    ],
    [
      "user-agent",
      "[user-agent]"
    ],
    [
      "x-api-key",
      "[redacted]"
    ]
  ],
  "body": {
    "model": "claude-sonnet-4-6",
    "system": [
      {
        "type": "text",
        "text": "Use the tools when they help.",
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is the weather in Paris?"
          }
        ]
      }
    ],
    "max_tokens": 128,
    "tools": [
      {
        "name": "get_weather",
        "description": "Reads the current weather for a city",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      },
      {
        "name": "get_time",
        "description": "Reads the current time in a time zone",
        "input_schema": {
          "type": "object",
          "properties": {
            "zone": {
              "type": "string"
            }
          },
          "required": [
            "zone"
          ]
        },
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "tool_choice": {
      "type": "any"
    },
    "stream": false
  }
}
