# Public value constructors and compatibility deserializers are driven by JSON.

```console
$ lithos-llm-e2e values values.json
{
  "kind": "values",
  "messages": [
    {
      "role": "tool",
      "content": [
        {
          "type": "text",
          "text": "done"
        }
      ],
      "name": "worker",
      "tool_call_id": "call-7",
      "serialized": {
        "role": "tool",
        "content": [
          {
            "type": "text",
            "text": "done"
          }
        ],
        "name": "worker",
        "tool_call_id": "call-7"
      }
    }
  ],
  "media": [
    {
      "media_type": null,
      "base64_data": null,
      "part": {
        "type": "image",
        "source": {
          "type": "url",
          "url": "https://example.com/image.png"
        }
      },
      "opaque_namespace": null
    },
    {
      "media_type": "audio/wav",
      "base64_data": null,
      "part": {
        "type": "audio",
        "source": {
          "type": "url",
          "url": "https://example.com/audio",
          "media_type": "audio/wav"
        }
      },
      "opaque_namespace": null
    },
    {
      "media_type": "application/pdf",
      "base64_data": "cGRm",
      "part": {
        "type": "document",
        "source": {
          "type": "base64",
          "data": "cGRm",
          "media_type": "application/pdf"
        }
      },
      "opaque_namespace": null
    },
    {
      "media_type": "image/gif",
      "base64_data": "R0lG",
      "part": {
        "type": "image",
        "source": {
          "type": "base64",
          "data": "R0lG",
          "media_type": "image/gif"
        }
      },
      "opaque_namespace": null
    },
    {
      "media_type": null,
      "base64_data": null,
      "part": {
        "type": "document",
        "source": {
          "type": "url",
          "url": "not-a-data-uri"
        }
      },
      "opaque_namespace": null
    }
  ],
  "custom_tools": [
    {
      "custom": true,
      "tool": {
        "name": "shell",
        "description": "Run input",
        "kind": {
          "type": "custom",
          "format": {
            "type": "grammar",
            "syntax": "cmd"
          }
        }
      }
    }
  ],
  "custom_calls": [
    {
      "id": "custom-1",
      "name": "shell",
      "input": {
        "type": "custom",
        "value": "echo hello"
      }
    }
  ],
  "finish_reasons": [
    {
      "input": "stop",
      "result": "stop"
    },
    {
      "input": "length",
      "result": "length"
    },
    {
      "input": "tool_call",
      "result": "tool_call"
    },
    {
      "input": "tool_calls",
      "result": "tool_calls"
    },
    {
      "input": "content_filter",
      "result": "content_filter"
    },
    {
      "input": "error",
      "result": "error"
    },
    {
      "input": "incomplete",
      "result": "incomplete"
    },
    {
      "input": "provider_reason",
      "result": "provider_reason"
    },
    {
      "input": {
        "other": "legacy_reason"
      },
      "error": "invalid type: map, expected a finish reason string"
    },
    {
      "input": {},
      "error": "invalid type: map, expected a finish reason string"
    },
    {
      "input": {
        "wrong": "value"
      },
      "error": "invalid type: map, expected a finish reason string"
    },
    {
      "input": 7,
      "error": "invalid type: integer `7`, expected a finish reason string"
    }
  ],
  "warnings": [
    {
      "input": {
        "code": null,
        "message": "legacy"
      },
      "error": "invalid type: null, expected a string"
    },
    {
      "input": {
        "code": "notice",
        "message": "current"
      },
      "result": {
        "code": "notice",
        "message": "current"
      }
    }
  ],
  "inclusive_tokens": [
    {
      "tokens": {
        "input": 60,
        "output": 15,
        "reasoning": 5,
        "cache_read": 30,
        "cache_write": 10
      },
      "total": 120,
      "billable_output": 20
    },
    {
      "tokens": {
        "input": 0,
        "output": 0,
        "reasoning": 3,
        "cache_read": 2,
        "cache_write": 0
      },
      "total": 5,
      "billable_output": 3
    }
  ]
}

```

# Catalog validation failures are one declarative matrix.

```console
$ lithos-llm-e2e catalog-errors catalog-errors.json
{
  "kind": "catalog_errors",
  "cases": [
    {
      "name": "parse",
      "error": "catalog layer `catalog-parse.toml` is invalid TOML",
      "causes": [
        "TOML parse error at line 1, column 6/n  |/n1 | this is not valid TOML/n  |      ^/nexpected `.`, `=`/n"
      ]
    },
    {
      "name": "schema",
      "error": "catalog schema version 2 is not supported",
      "causes": []
    },
    {
      "name": "empty",
      "error": "the catalog has no providers",
      "causes": []
    },
    {
      "name": "provider_id",
      "error": "catalog layer `catalog-provider-id.toml` produced an invalid catalog",
      "causes": [
        "provider identifier `bad provider` is invalid"
      ]
    },
    {
      "name": "provider_display",
      "error": "catalog layer `catalog-provider-display.toml` produced an invalid catalog",
      "causes": [
        "test has an empty display name"
      ]
    },
    {
      "name": "base_url",
      "error": "catalog layer `catalog-base-url.toml` produced an invalid catalog",
      "causes": [
        "provider test has an empty base URL"
      ]
    },
    {
      "name": "provider_alias",
      "error": "catalog layer `catalog-provider-alias.toml` produced an invalid catalog",
      "causes": [
        "provider alias identifier `bad alias` is invalid"
      ]
    },
    {
      "name": "duplicate_provider_alias",
      "error": "catalog layer `catalog-duplicate-provider-alias.toml` produced an invalid catalog",
      "causes": [
        "provider alias `shared` is defined more than once"
      ]
    },
    {
      "name": "model_id",
      "error": "catalog layer `catalog-model-id.toml` produced an invalid catalog",
      "causes": [
        "model identifier `bad model` is invalid"
      ]
    },
    {
      "name": "model_display",
      "error": "catalog layer `catalog-model-display.toml` produced an invalid catalog",
      "causes": [
        "test/model has an empty display name"
      ]
    },
    {
      "name": "duplicate_model_selector",
      "error": "catalog layer `catalog-duplicate-model-selector.toml` produced an invalid catalog",
      "causes": [
        "model selector `second` is defined more than once for provider test"
      ]
    },
    {
      "name": "default_model",
      "error": "catalog layer `catalog-default-model.toml` produced an invalid catalog",
      "causes": [
        "provider test names unknown default model `missing`"
      ]
    },
    {
      "name": "limits",
      "error": "catalog layer `catalog-limits.toml` produced an invalid catalog",
      "causes": [
        "model test/model has an output limit above its context limit"
      ]
    },
    {
      "name": "header_name",
      "error": "catalog layer `catalog-header-name.toml` produced an invalid catalog",
      "causes": [
        "provider test declares invalid default header name `bad header`"
      ]
    },
    {
      "name": "header_value",
      "error": "catalog layer `catalog-header-value.toml` produced an invalid catalog",
      "causes": [
        "provider test declares an invalid value for default header `x-test`"
      ]
    }
  ]
}

```

# Client capability validation runs before any provider request.

```console
$ OPENAI_API_KEY=validation lithos-llm-e2e calls client-catalog.toml client-requests.json
{
  "kind": "calls",
