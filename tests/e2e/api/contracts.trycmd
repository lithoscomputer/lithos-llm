        },
        "response_format": {
          "type": "json_schema",
          "name": "answer",
          "schema": {
            "type": "object"
          }
        },
        "max_output_tokens": 42,
        "temperature": 0.5,
        "top_p": 0.75,
        "reasoning_effort": "xhigh",
        "cache_hint": {
          "type": "key",
          "key": "cache-key"
        },
        "speed": "fast",
        "timeout": 1250,
        "stop_sequences": [
          "ONE",
          "TWO",
          "THREE"
        ],
        "metadata": {
          "trace": "yes"
        },
        "provider_options": {
          "fixture": {
            "one": 1,
            "two": true
          }
        }
      }
    },
    {
      "name": "missing_model",
      "result": "error",
      "message": "a model selector is required"
    },
    {
      "name": "empty_model",
      "result": "error",
      "message": "the model selector must not be empty"
    },
    {
      "name": "no_messages",
      "result": "error",
      "message": "at least one message is required"
    },
    {
      "name": "empty_message",
      "result": "error",
      "message": "messages must contain at least one content part"
    },
    {
      "name": "zero_output",
      "result": "error",
      "message": "max_output_tokens must be greater than zero"
    },
    {
      "name": "temperature_low",
      "result": "error",
      "message": "temperature must be between 0 and 2"
    },
    {
      "name": "temperature_high",
      "result": "error",
      "message": "temperature must be between 0 and 2"
    },
    {
      "name": "top_p_low",
      "result": "error",
      "message": "top_p must be between 0 and 1"
    },
    {
      "name": "top_p_high",
      "result": "error",
      "message": "top_p must be between 0 and 1"
    },
    {
      "name": "zero_timeout",
      "result": "error",
      "message": "timeout must be greater than zero"
    },
    {
      "name": "empty_stop",
      "result": "error",
      "message": "stop sequences must not be empty"
    },
    {
      "name": "empty_metadata",
      "result": "error",
      "message": "metadata keys must not be empty"
    },
    {
      "name": "empty_tool",
      "result": "error",
      "message": "tool names must not be empty"
    },
    {
      "name": "duplicate_tool",
      "result": "error",
      "message": "tool names must be unique"
    },
    {
      "name": "custom_format",
      "result": "error",
      "message": "custom tools must define a format"
    },
    {
      "name": "unknown_choice",
      "result": "error",
      "message": "the selected tool must be present in the request tools"
    },
    {
      "name": "empty_schema",
      "result": "error",
      "message": "JSON schema names must not be empty"
    },
    {
      "name": "empty_provider",
      "result": "error",
      "message": "provider option namespaces must not be empty"
    }
  ]
}

