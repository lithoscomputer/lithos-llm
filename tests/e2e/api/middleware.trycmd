# Middleware behavior is defined in JSON and asserted as command output.

```console
$ lithos-llm-e2e simulate complete_retry.json
{
  "kind": "simulation",
  "result": {
    "kind": "complete",
    "text": "complete after retry",
    "tokens": 15
  },
  "adapter_calls": 2,
  "attempts": [
    1,
    2
  ],
  "extension_exercised": true,
  "observer": {
    "starts": 2,
    "completes": 2,
    "events": 0,
    "errors": 1,
    "retries": 1,
    "request_retries": 1,
    "stream_retries": 0
  }
}

$ lithos-llm-e2e simulate retry_after_cap.json
{
  "kind": "simulation",
  "result": {
    "kind": "error",
    "error_kind": "Server",
    "message": "wait too long",
    "provider": "fixture",
    "status": 503,
    "provider_code": "fixture_error",
    "retry": "After { millis: 10 }"
  },
  "adapter_calls": 1,
  "attempts": [
    1
  ],
  "extension_exercised": false,
  "observer": {
    "starts": 0,
    "completes": 0,
    "events": 0,
    "errors": 0,
    "retries": 0,
    "request_retries": 0,
    "stream_retries": 0
  }
}

