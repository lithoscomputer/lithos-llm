```console
$ OPENAI_API_KEY=oai-stream-idle-timeout lithos-llm-e2e call-case twin-catalog.toml idle-timeout.json
{
  "kind": "stream",
  "events": [
    {
      "name": "started:visible=false",
      "event": {
        "type": "started",
        "id": null
      }
    },
    {
      "name": "block_start:visible=false",
      "event": {
        "type": "content_block_start",
        "id": "msg_idle",
        "kind": {
          "type": "text"
        }
      }
    },
    {
      "name": "text:visible=true",
      "event": {
        "type": "text_delta",
        "id": "msg_idle",
        "text": "Before idle"
      }
    },
    {
      "kind": "error",
      "error": {
        "kind": "error",
        "error_kind": "Timeout",
        "message": "provider openai stopped sending stream data",
        "provider": "openai",
        "status": null,
        "provider_code": null,
        "retry": "Safe"
      },
      "data": {
        "kind": "timeout",
        "message": "provider openai stopped sending stream data",
        "provider": "openai",
        "retry": {
          "type": "safe"
        },
        "source_message": "deadline has elapsed"
      },
      "debug": "Error { kind: Timeout, provider: Some(ProviderId(/"openai/")), status: None, provider_code: None, retry: Safe, provider_retry_after_millis: None, has_raw_data: false, has_source: true, .. }",
      "display": "provider openai stopped sending stream data",
      "retry_after_ms": null,
      "provider_retry_after_ms": null,
      "raw_data": null,
      "source": "deadline has elapsed"
    }
  ]
}

```

```console
$ OPENAI_API_KEY=transport lithos-llm-e2e call headers-catalog.toml headers.json
{
  "kind": "complete",
  "text": "headers accepted",
  "response": {
    "id": "resp-headers",
    "model": {
      "provider": "openai",
      "model": "headers"
    },
    "content": [
      {
        "type": "text",
        "text": "headers accepted"
      },
      {
        "type": "opaque",
        "kind": "openai.message",
        "data": {
          "type": "message",
          "role": "assistant",
          "content": [
            {
              "type": "output_text",
              "text": "headers accepted"
            }
          ]
        }
      }
    ],
    "finish_reason": "stop",
    "usage": {
      "input": 2,
      "output": 2,
      "reasoning": 0,
      "cache_read": 0,
      "cache_write": 0
    },
    "raw": {
      "id": "resp-headers",
      "status": "completed",
      "output": [
        {
          "type": "message",
          "role": "assistant",
          "content": [
            {
              "type": "output_text",
              "text": "headers accepted"
            }
          ]
        }
      ],
      "usage": {
        "input_tokens": 2,
        "output_tokens": 2
      }
    }
  }
}

```

