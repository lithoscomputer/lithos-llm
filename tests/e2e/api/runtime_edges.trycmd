# Client construction and resolution are selected by declarative records.

```console
$ lithos-llm-e2e client-builds client-builds.json
{
  "kind": "client_builds",
  "cases": [
    {
      "name": "missing_catalog",
      "error": "a catalog is required",
      "source": null
    },
    {
      "name": "from_env",
      "result": "ok"
    },
    {
      "name": "all_providers",
      "result": "ok",
      "client": "Client { available_providers: AvailableProviders { providers: {ProviderId(/"healthy/")} }, .. }",
      "available": [
        "healthy"
      ],
      "all": [
        "healthy",
        "invalid-options",
        "missing",
        "wrong-codec"
      ],
      "issues": [
        {
          "provider": "invalid-options",
          "adapter": "openai",
          "cause": "adapter construction failed",
          "source": "provider invalid-options has invalid adapter options"
        },
        {
          "provider": "missing",
          "adapter": "custom-adapter",
          "cause": "no adapter factory is registered for adapter custom-adapter",
          "source": null
        },
        {
          "provider": "wrong-codec",
          "adapter": "openai",
          "cause": "adapter construction failed",
          "source": "provider wrong-codec uses unsupported codec anthropic-messages"
        }
      ]
    },
    {
      "name": "enabled_subset",
      "result": "ok",
      "client": "Client { available_providers: AvailableProviders { providers: {ProviderId(/"healthy/")} }, .. }",
      "available": [
        "healthy"
      ],
      "all": [
        "healthy",
        "invalid-options",
        "missing",
        "wrong-codec"
      ],
      "issues": []
    },
    {
      "name": "unknown_enabled",
      "error": "enabled provider `absent` is not in the catalog",
      "source": null
    }
  ]
}

```

```console
$ lithos-llm-e2e resolve-matrix resolver.json
{
  "kind": "resolve_matrix",
  "cases": [
    {
      "name": "provider_without_default",
      "error": "provider alpha has no default model"
    },
    {
      "name": "provider_unavailable",
      "error": "provider beta has no registered adapter"
    },
    {
      "name": "unknown_model",
      "error": "model selector `unknown` was not found"
    },
    {
      "name": "success",
      "result": "ok",
      "provider": "beta",
      "model": "two",
      "api_model": "beta-two",
      "handle": {
        "provider": "beta",
        "model": "two"
      }
    }
  ]
}

```

# HTTP edge behavior uses local deterministic response fixtures.

```console
$ OPENAI_API_KEY=transport lithos-llm-e2e call transport-catalog.toml invalid-json.json
{
  "kind": "error",
  "error": {
    "kind": "error",
    "error_kind": "ResponseDecode",
    "message": "provider openai returned invalid JSON",
    "provider": "openai",
    "status": null,
    "provider_code": null,
    "retry": "Safe"
  },
  "data": {
    "kind": "response_decode",
    "message": "provider openai returned invalid JSON",
    "provider": "openai",
    "retry": {
      "type": "safe"
    },
    "source_message": "error decoding response body for url (http://127.0.0.1:3932/v1/responses)"
  },
  "debug": "Error { kind: ResponseDecode, provider: Some(ProviderId(/"openai/")), status: None, provider_code: None, retry: Safe, provider_retry_after_millis: None, has_raw_data: false, has_source: true, .. }",
  "display": "provider openai returned invalid JSON",
  "retry_after_ms": null,
  "provider_retry_after_ms": null,
  "raw_data": null,
  "source": "error decoding response body for url (http://127.0.0.1:3932/v1/responses)"
}

```

```console
$ OPENAI_API_KEY=transport lithos-llm-e2e call transport-catalog.toml complete-timeout.json
