t_item.done\",\"output_index\":2,\"item\":{\"id\":\"function-edge\",\"call_id\":\"call-edge\",\"type\":\"function_call\",\"name\":\"lookup\",\"arguments\":\"{\\\"x\\\":1}\"}}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"output_index\":3,\"item\":{\"id\":\"custom-edge\",\"call_id\":\"custom-call\",\"type\":\"custom_tool_call\",\"name\":\"shell\",\"input\":\"\"}}\n\nevent: response.custom_tool_call_input.delta\ndata: {\"type\":\"response.custom_tool_call_input.delta\",\"item_id\":\"custom-edge\",\"delta\":\"echo ready\"}\n\nevent: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"output_index\":3,\"item\":{\"id\":\"custom-edge\",\"call_id\":\"custom-call\",\"type\":\"custom_tool_call\",\"name\":\"shell\",\"input\":\"echo ready\"}}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"output_index\":4,\"item\":{\"id\":\"internal-edge\",\"type\":\"function_call\",\"arguments\":\"{}\"}}\n\nevent: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"item_id\":\"internal-edge\",\"delta\":\"{}\"}\n\nevent: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"output_index\":4,\"item\":{\"id\":\"internal-edge\",\"type\":\"function_call\",\"arguments\":\"{}\"}}\n\nevent: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp-edge\",\"status\":\"completed\",\"output\":[{\"id\":\"msg-edge\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Edge stream\"}]},{\"id\":\"reason-edge\",\"type\":\"reasoning\",\"content\":[{\"type\":\"reasoning_text\",\"text\":\"Reason complete\"}],\"summary\":[],\"encrypted_content\":\"cipher\"},{\"id\":\"function-edge\",\"call_id\":\"call-edge\",\"type\":\"function_call\",\"name\":\"lookup\",\"arguments\":\"{\\\"x\\\":1}\"}],\"usage\":{\"input_tokens\":20,\"output_tokens\":8,\"output_tokens_details\":{\"reason