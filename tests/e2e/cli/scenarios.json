    {
      "scenario_id": "oai-complete",
      "namespace": "oai-complete",
      "matcher": {
        "endpoint": "responses",
        "model": "responses-v1",
        "stream": false,
        "input_contains": "OpenAI complete transcript"
      },
      "script": {
        "kind": "transcript",
        "status": 200,
        "content_type": "application/json",
        "body": {
          "id": "resp_complete",
          "object": "response",
          "status": "completed",
          "output": [
            {
              "id": "rs_complete",
              "type": "reasoning",
              "content": [
                { "type": "reasoning_text", "text": "First reason." },
                { "type": "reasoning_text", "text": "Second reason." }
              ],
              "summary": [{ "type": "summary_text", "text": "Summary." }],
              "encrypted_content": "opaque"
            },
            {
              "id": "msg_complete",
              "type": "message",
              "status": "completed",
              "role": "assistant",
              "content": [
                { "type": "output_text", "text": "Hello " },
                { "type": "output_text", "text": "there." },
                { "type": "unknown", "text": "ignored" }
              ]
            },
            {
              "id": "fc_complete",
              "call_id": "call_complete",
              "type": "function_call",
              "name": "add",
              "arguments": "{\"a\":1,\"b\":2}"
            },
            {
              "id": "custom_complete",
              "call_id": "call_custom",
              "type": "custom_tool_call",
              "name": "shell",
              "input": "echo ready"
            },
            { "id": "internal", "type": "web_search_call", "status": "completed" }
          ],
          "usage": {
            "input_tokens": 100,
            "input_tokens_details": { "cached_tokens": 25, "cache_write_tokens": 5 },
            "output_tokens": 30,
            "output_tokens_details": { "reasoning_tokens": 10 }
          }
        }
      }
    },
