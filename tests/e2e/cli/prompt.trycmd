# Prompt calls run through the real binary and the deterministic twin.

```console
$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --no-stream 'Complete prompt'
Hello from twin

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml prompt --model openrouter/fixture --no-stream --no-cache --timeout 2s 'Explicit prompt'
Hello from twin

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture 'Streaming prompt'
Hello from twin

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --schema 'name, age int' --no-stream 'Invent a person'
{"name":"Ada","age":37}

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --schema-multi 'name, age int' --no-stream 'Invent people'
? 2
error: invalid_request: provider openrouter unsupported json_schema root type route=openrouter/fixture provider=openrouter status=400 code=invalid_request

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --json-object --no-stream 'Return an object'
{"answer":"fixture"}

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --no-stream --system 'Base policy' -f context.txt --system-fragment system.txt Review
Context received

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --no-stream --schema @schema.json 'Use a schema file'
{"name":"Ada","age":37}

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --no-stream --attachment-type attachment.txt image/png 'Read the attachment'
Attachment received

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --no-stream --attachment https://example.com/pixel.png 'Describe the image'
Attachment received

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --extract 'Return first fenced code'
fn main() {}

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --xl 'Return last fenced code'
fn main() {}

$ OPENROUTER_API_KEY=trycmd-prompts lllm --catalog catalog.toml --model openrouter/fixture --json --no-stream --max-output-tokens 42 --temperature 0.5 --top-p 0.8 --reasoning-effort high --stop END --cache-key cache-one --metadata trace=yes --option custom=3 'JSON controls'
