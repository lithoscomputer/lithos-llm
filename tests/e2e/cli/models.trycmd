# Model status, filters, aliases, defaults, and JSON are CLI contracts.

```console
$ LLLM_MODEL=local/fixture lllm --catalog catalog.toml models --provider local
DEFAULT  SELECTOR         NAME           ADAPTER   CREDENTIALS  ALIASES               CAPABILITIES
yes      local/fixture    Fixture model  yes       yes          fixture-alias         text,images,documents,tools,structured-output,caching,sampling
         local/text-only  Text only      yes       yes                                text

$ LLLM_MODEL=local/fixture lllm --catalog catalog.toml models --provider local --capability tools
DEFAULT  SELECTOR       NAME           ADAPTER   CREDENTIALS  ALIASES               CAPABILITIES
yes      local/fixture  Fixture model  yes       yes          fixture-alias         text,images,documents,tools,structured-output,caching,sampling

$ LLLM_MODEL=local/fixture lllm --catalog catalog.toml models --provider local --capability structured-output
DEFAULT  SELECTOR       NAME           ADAPTER   CREDENTIALS  ALIASES               CAPABILITIES
yes      local/fixture  Fixture model  yes       yes          fixture-alias         text,images,documents,tools,structured-output,caching,sampling

$ LLLM_MODEL=local/fixture lllm --catalog catalog.toml models fixture
DEFAULT  SELECTOR       NAME           ADAPTER   CREDENTIALS  ALIASES               CAPABILITIES
yes      local/fixture  Fixture model  yes       yes          fixture-alias         text,images,documents,tools,structured-output,caching,sampling

$ LLLM_MODEL=local/fixture lllm --catalog catalog.toml models --provider local --configured --adapter-compiled
DEFAULT  SELECTOR         NAME           ADAPTER   CREDENTIALS  ALIASES               CAPABILITIES
yes      local/fixture    Fixture model  yes       yes          fixture-alias         text,images,documents,tools,structured-output,caching,sampling
         local/text-only  Text only      yes       yes                                text

$ LLLM_MODEL=local/fixture lllm --catalog catalog.toml models --default
DEFAULT  SELECTOR       NAME           ADAPTER   CREDENTIALS  ALIASES               CAPABILITIES
yes      local/fixture  Fixture model  yes       yes          fixture-alias         text,images,documents,tools,structured-output,caching,sampling

